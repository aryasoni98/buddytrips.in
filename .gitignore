# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# package managers
.pnpm-store/
.npm/
*.tgz

# generated AEO text (npm prebuild)
/public/llms.txt
/public/llms-full.txt
/public/api/md/

# next.js
/.next/
/out/
/.turbo
next-env.d.ts

# production
/build
/dist

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# caches
.eslintcache
.prettiercache
.stylelintcache
*.tsbuildinfo
.cache/
.parcel-cache/
.swc/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
bun-debug.log*

# env - keep committed examples, ignore the rest
.env
.env.*
!.env.example
!.env*.example

# vercel
.vercel

# certificates / secrets
*.pem
*.p12
*.key
*.crt

# os
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# editors
.idea/
*.swp
*.swo
*~

# local dumps (Google Drive zip extracts)
public/Itinerary/drive-download-*/
